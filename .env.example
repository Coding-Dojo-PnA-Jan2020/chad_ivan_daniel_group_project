# Copy to .env and fill in real values. NEVER commit .env.
# The app also reads any variable matching a config key via Flask's
# from_prefixed_env (e.g. SECRET_KEY, DATABASE_URL, FLASK_CONFIG).

# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Dev fallback: a random key is generated per process (sessions/whispers reset on restart).
FLASK_CONFIG=development
SECRET_KEY=change-me-generate-a-real-one

# Database. Defaults to a local SQLite file when unset.
# MySQL example: mysql+pymysql://whisper:password@localhost:3306/whisper
DATABASE_URL=

# Generated default avatar style (https://www.dicebear.com/styles/)
AVATAR_STYLE=adventurer

# Optional: shared rate-limit storage (e.g. redis://localhost:6379/0).
# Defaults to in-process memory, which is fine for a single instance.
RATELIMIT_STORAGE_URI=
